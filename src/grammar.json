              },
              {
                "type": "STRING",
                "value": "::"
              },
              {
                "type": "SYMBOL",
                "name": "_binary_or_atom"
              }
            ]
          }
        },
        {
          "type": "PREC_LEFT",
          "value": "additive",
          "content": {
            "type": "SEQ",
            "members": [
