-- literals
[1 2 3] -- list
{1 2 3} -- tuple
"hello" -- string
1       -- int
-1      -- int
1.0     -- float
-1.0    -- float
:some   -- variant


-- everything else
patt := {patt+} | [patt+] | bool | int | float | string | ident | :ident
expr := {expr+} | [expr+] | bool | int | float | string | ident | :ident

(function (name patt) expr+)
(function (name (patt+)) expr+)

branch := (patt expr+)

(match expr branch+)

(let patt expr)

(fun patt expr+)
(fun (patt+) expr+)
